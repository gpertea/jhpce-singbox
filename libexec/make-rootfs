#!/usr/bin/env bash
# Create the skeleton directory used as the container root filesystem.
# It holds only empty mount-point directories and the usr-merge symlinks; all real
# content (/usr, /etc, /opt, ...) is bind-mounted read-only from the host at launch.
#
# Usage: make-rootfs [DEST]     (default: <repo>/share/rootfs)
set -euo pipefail
ROOT=$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")
DEST=${1:-$ROOT/share/rootfs}
mkdir -p "$DEST"
cd "$DEST"
# Only system mount points and the host's top-level symlinks (bin -> usr/bin, ...).
# Storage roots (/dcs04, /dcl01, ...) are deliberately absent: the runtime creates
# the ones that are bound, and anything not bound stays missing. An empty
# placeholder would make a symlink into unmounted storage look like an empty
# folder instead of a broken link, which misleads a crawler.
for e in /*; do
    n=${e#/}
    [ -L "$e" ] && ln -sfn "$(readlink "$e")" "$n"
done
mkdir -p usr etc opt proc sys dev run tmp root var/tmp var/lib/sss var/lib/alternatives
# Placeholders so the runtime can stage its own files before /etc is bound over them.
mkdir -p etc
for f in passwd group hosts localtime resolv.conf; do : > "etc/$f"; done
chmod -R a+rX,go-w "$DEST"
# An always-empty folder, mounted read-only over places that must look empty inside
# (e.g. ~/.ssh when the real home is used).
EMPTY=$(dirname "$DEST")/empty
mkdir -p "$EMPTY"
chmod 555 "$EMPTY"
echo "rootfs skeleton ready: $DEST (empty mask: $EMPTY)"
