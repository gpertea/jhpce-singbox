#!/usr/bin/env bash
# Create the skeleton directory used as the container root filesystem.
# It holds only empty mount-point directories and the usr-merge symlinks; all real
# content (/usr, /etc, /opt, ...) is bind-mounted read-only from the host at launch.
#
# Usage: make-rootfs [DEST]     (default: <repo>/share/rootfs)
set -euo pipefail
ROOT=$(dirname "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")")
DEST=${1:-$ROOT/share/rootfs}
mkdir -p "$DEST"
cd "$DEST"
# Mirror the host's top-level layout: directories become empty mount points,
# symlinks (bin -> usr/bin, ...) are copied as symlinks.
for e in /*; do
    n=${e#/}
    if [ -L "$e" ]; then
        ln -sfn "$(readlink "$e")" "$n"
    elif [ -d "$e" ]; then
        mkdir -p "$n"
    fi
done
mkdir -p var/tmp var/lib/sss var/lib/alternatives tmp run
# Placeholders so the runtime can stage its own files before /etc is bound over them.
mkdir -p etc
for f in passwd group hosts localtime resolv.conf; do : > "etc/$f"; done
chmod -R a+rX,go-w "$DEST"
echo "rootfs skeleton ready: $DEST"
