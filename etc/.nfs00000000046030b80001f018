# libd-ai-sandbox SYSTEM mounts (site file, for module maintainers).
#
# Users do not edit this file. Data folders (/dcs04/lieber, ...) are not listed here:
# they are 'read =' lines in profiles, starting with etc/profiles/default.conf.
#
# This file lists what makes the sandbox look like the node it runs on. Every entry
# is mounted read-only in every session.
#
# Columns (whitespace separated): src  dest  mode  required
#   mode      must be "ro"
#   required  yes = abort if src is missing; no = skip with a warning
#
# Every src must be a real mount point or lie inside one; never an autofs map root.
# The wrapper checks this against /proc/mounts at every launch.

# --- host system -----------------------------------------------------------------
/usr                    /usr                    ro  yes
/etc                    /etc                    ro  yes
/opt                    /opt                    ro  yes
/var/lib/sss            /var/lib/sss            ro  yes   # SSSD sockets: user and group names
/var/lib/alternatives   /var/lib/alternatives   ro  no

# --- shared software and module trees ---------------------------------------
/jhpce/shared           /jhpce/shared           ro  yes
