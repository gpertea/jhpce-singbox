#!/usr/bin/env bash
# libd-ai-sandbox: run a shell or an AI agent on JHPCE with LIBD/JHPCE storage
# mounted read-only. Writable by default: $MYSCRATCH, the synthetic home, /tmp,
# plus each --write PATH.
#
# The container root is a skeleton directory; the host's /usr, /etc, /opt and the
# storage/software trees from the mounts files are bind-mounted read-only on top,
# so the environment (modules, conda_R, users) matches the host node.
set -euo pipefail

PROG=libd-ai-sandbox
VERSION=0.3.0-dev
SELF=$(readlink -f "${BASH_SOURCE[0]}")
ROOT=${LIBD_AI_SANDBOX_ROOT:-$(dirname "$(dirname "$SELF")")}
RUNTIME=${LIBD_AI_SANDBOX_RUNTIME:-/jhpce/shared/jhpce/core/singularity/3.11.4/bin/singularity}
MOUNTS=${LIBD_AI_SANDBOX_MOUNTS:-$ROOT/etc/mounts.tsv}
ROOTFS=${LIBD_AI_SANDBOX_ROOTFS:-$ROOT/share/rootfs}
DENY_LIST=${LIBD_AI_SANDBOX_DENY:-$ROOT/etc/deny-commands.txt}
DENY_BIN=$ROOT/libexec/deny

REAL_HOME=$(getent passwd "$(id -un)" | cut -d: -f6)
REAL_HOME=${REAL_HOME:-$HOME}
CONFIG_DIR=${LIBD_AI_SANDBOX_CONFIG_DIR:-$REAL_HOME/.config/libd-ai-sandbox}
USER_MOUNTS=$CONFIG_DIR/mounts.tsv
SKEL=$CONFIG_DIR/skel
STATE=${LIBD_AI_SANDBOX_STATE:-$REAL_HOME/.libd-ai-sandbox}
SBX_HOME=${LIBD_AI_SANDBOX_HOME:-$STATE/home}
SBX_LOGS=$STATE/logs
USER_CONFIG=$CONFIG_DIR/config
USER_PROFILES=$CONFIG_DIR/profiles
SITE_PROFILES=$ROOT/etc/profiles
R_HOOK=$ROOT/share/R/sandbox-Rprofile.R
HOST_HOME_DIR=/host_home      # read-only pieces of the real home, inside the container

# Host paths that may never be made writable.
PROTECTED_PREFIXES=(/usr /etc /opt /var /boot /proc /sys /dev /run /jhpce/shared)

usage() {
    cat <<EOF
Usage: $PROG [options] [-- command [args...]]

Starts a login shell (or the given command) in a container where LIBD/JHPCE storage
is read-only. Writable: \$MYSCRATCH (unless --no-scratch), the synthetic home, /tmp,
and each --write PATH.

Options:
  --write PATH      make PATH writable at the same path (repeatable). PATH must
                    exist, may not be a whole filesystem (e.g. /dcs04/lieber),
                    a system path, or contain other mounted filesystems
  --read PATH       add PATH read-only at the same path (repeatable)
  --no-scratch      do not mount \$MYSCRATCH writable
  --profile NAME    apply a saved profile (repeatable; see below)
  --list-profiles   list available profiles and exit
  --module NAME     module to load at session start (repeatable)
  --no-personal-libs
                    synthetic home only: do not expose your real ~/R and
                    ~/.local/lib read-only (default: exposed at $HOST_HOME_DIR and
                    added after the writable sandbox libraries)
  --home-mode MODE  synthetic (default): \$HOME is a separate sandbox home
                    real-ro: \$HOME is your real home, read-only
                    real-rw: \$HOME is your real home, WRITABLE (at your own risk:
                             the agent can change dotfiles your host logins run)
  --cmd STRING      run STRING with 'bash -lc' instead of an interactive shell
  --agent NAME      shell (default); codex and claude are not implemented yet
  --reset-home      archive the synthetic home and start a fresh one
  --dry-run         print binds and the runtime command, then exit
  --print-binds     print the resolved bind table and exit
  --quiet           suppress the startup banner and warnings
  --version
  -h, --help

Synthetic home (--home-mode synthetic):
  \$HOME inside is $SBX_HOME on the host; it persists between sessions.
  Its ~/.bashrc runs at every session start, after the JHPCE site profile: add
  'module load ...' lines there. Edit it from the host or inside (nano ~/.bashrc);
  in a running session apply changes with 'source ~/.bashrc'.

Per-user customization ($CONFIG_DIR):
  mounts.tsv   extra read-only mounts, same format as the site mounts file
  skel/        files copied into the synthetic home when missing there
               (e.g. skel/.bashrc as your durable template)
  config       defaults, 'key = value' lines: home_mode, scratch, personal_libs,
               agent, module, read  (not write: writable paths need a profile
               or the command line)
  profiles/NAME.conf
               same keys plus 'write' and 'description'; used with --profile NAME.
               Site profiles: $SITE_PROFILES/NAME.conf
  Values may use ~, \$HOME, \$USER, \$MYSCRATCH. Lists (module, read, write)
  accumulate; for single values the last one wins, in the order: config,
  environment, profiles, command line.

Environment:
  LIBD_AI_SANDBOX_HOME          synthetic home location [$SBX_HOME]
  LIBD_AI_SANDBOX_HOME_MODE     default --home-mode [$HOME_MODE]
  LIBD_AI_SANDBOX_CONFIG_DIR    per-user config dir [$CONFIG_DIR]
  LIBD_AI_SANDBOX_RUNTIME       runtime binary [$RUNTIME]
  LIBD_AI_SANDBOX_MOUNTS        site read-only mounts file [$MOUNTS]
  LIBD_AI_SANDBOX_MOUNTS_EXTRA  one more mounts file (same format)
  LIBD_AI_SANDBOX_ROOTFS        skeleton root directory [$ROOTFS]
EOF
}

die()  { echo "$PROG: error: $*" >&2; exit 2; }
warn() { [ "$QUIET" = 1 ] || echo "$PROG: warning: $*" >&2; }

# ---------------------------------------------------------------- options --
WRITE_REQ=(); READ_REQ=(); MODULES=(); CLI_MODULES=(); PROFILES=(); CMD_STR=""; ARGV=()
CLI_HOME_MODE=""; CLI_SCRATCH=""; CLI_PERSONAL=""; CLI_AGENT=""
DRY_RUN=0; PRINT_BINDS=0; QUIET=0; RESET_HOME=0; LIST_PROFILES=0
while [ $# -gt 0 ]; do
    case "$1" in
        --write)        [ $# -ge 2 ] || die "--write needs a path"; WRITE_REQ+=("$2"); shift 2 ;;
        --write=*)      WRITE_REQ+=("${1#*=}"); shift ;;
        --read)         [ $# -ge 2 ] || die "--read needs a path"; READ_REQ+=("$2"); shift 2 ;;
        --read=*)       READ_REQ+=("${1#*=}"); shift ;;
        --no-scratch)   CLI_SCRATCH=no; shift ;;
        --profile)      [ $# -ge 2 ] || die "--profile needs a name"; PROFILES+=("$2"); shift 2 ;;
        --profile=*)    PROFILES+=("${1#*=}"); shift ;;
        --list-profiles) LIST_PROFILES=1; shift ;;
        --module)       [ $# -ge 2 ] || die "--module needs a name"; CLI_MODULES+=("$2"); shift 2 ;;
        --module=*)     CLI_MODULES+=("${1#*=}"); shift ;;
        --no-personal-libs) CLI_PERSONAL=no; shift ;;
        --personal-libs) CLI_PERSONAL=yes; shift ;;
        --home-mode)    [ $# -ge 2 ] || die "--home-mode needs a value"; CLI_HOME_MODE=$2; shift 2 ;;
        --home-mode=*)  CLI_HOME_MODE=${1#*=}; shift ;;
        --cmd)          [ $# -ge 2 ] || die "--cmd needs a string"; CMD_STR=$2; shift 2 ;;
        --agent)        [ $# -ge 2 ] || die "--agent needs a name"; CLI_AGENT=$2; shift 2 ;;
        --agent=*)      CLI_AGENT=${1#*=}; shift ;;
        --reset-home)   RESET_HOME=1; shift ;;
        --dry-run)      DRY_RUN=1; shift ;;
        --print-binds)  PRINT_BINDS=1; shift ;;
        --quiet|-q)     QUIET=1; shift ;;
        --version)      echo "$PROG $VERSION"; exit 0 ;;
        -h|--help)      usage; exit 0 ;;
        --)             shift; ARGV=("$@"); break ;;
        *)              die "unknown option '$1' (see --help)" ;;
    esac
done
[ -z "$CMD_STR" ] || [ ${#ARGV[@]} -eq 0 ] || die "use either --cmd or '-- command', not both"

# ------------------------------------------------- config and profiles ------
# Files are parsed, never sourced. Only the listed keys are accepted.
HOME_MODE=synthetic; SCRATCH_RW=1; PERSONAL_LIBS=1; AGENT=shell
PROFILE_FILES=()
expand_value() {   # ~, $HOME, $USER, $MYSCRATCH; nothing else is interpreted
    local v=$1
    case "$v" in "~") v=$REAL_HOME ;; "~/"*) v=$REAL_HOME/${v#\~/} ;; esac
    v=${v//\$\{HOME\}/$REAL_HOME}; v=${v//\$HOME/$REAL_HOME}
    v=${v//\$\{USER\}/$(id -un)}; v=${v//\$USER/$(id -un)}
    v=${v//\$\{MYSCRATCH\}/${MYSCRATCH:-}}; v=${v//\$MYSCRATCH/${MYSCRATCH:-}}
    printf '%s' "$v"
}
yesno() { case "$1" in yes|true|1) echo 1 ;; no|false|0) echo 0 ;; *) return 1 ;; esac; }
apply_conf() {   # FILE KIND(config|profile)
    local file=$1 kind=$2 line key val n=0 b
    while IFS= read -r line || [ -n "$line" ]; do
        n=$((n+1))
        line=${line%%#*}
        [[ "$line" =~ ^[[:space:]]*$ ]] && continue
        [[ "$line" =~ ^[[:space:]]*([a-z_]+)[[:space:]]*=[[:space:]]*(.*[^[:space:]])[[:space:]]*$ ]] ||
            die "$file:$n: expected 'key = value'"
        key=${BASH_REMATCH[1]}; val=$(expand_value "${BASH_REMATCH[2]}")
        case "$key" in
            home_mode)     HOME_MODE=$val ;;
            scratch)       b=$(yesno "$val") || die "$file:$n: scratch must be yes or no"; SCRATCH_RW=$b ;;
            personal_libs) b=$(yesno "$val") || die "$file:$n: personal_libs must be yes or no"; PERSONAL_LIBS=$b ;;
            agent)         AGENT=$val ;;
            module)        MODULES+=("$val") ;;
            read)          [[ "$val" == /* ]] || die "$file:$n: read path must be absolute"; READ_REQ+=("$val") ;;
            write)         [ "$kind" = profile ] ||
                               die "$file:$n: 'write' is only allowed in profiles (writable paths must be chosen per run)"
                           [[ "$val" == /* ]] || die "$file:$n: write path must be absolute"; WRITE_REQ+=("$val") ;;
            description)   [ "$kind" = profile ] || die "$file:$n: unknown key '$key'" ;;
            *)             die "$file:$n: unknown key '$key'" ;;
        esac
    done < "$file"
}
find_profile() {   # user profile wins over a site profile of the same name
    local name=$1
    [[ "$name" =~ ^[A-Za-z0-9_.-]+$ ]] || die "invalid profile name '$name'"
    if [ -f "$USER_PROFILES/$name.conf" ]; then echo "$USER_PROFILES/$name.conf"
    elif [ -f "$SITE_PROFILES/$name.conf" ]; then echo "$SITE_PROFILES/$name.conf"
    else die "profile '$name' not found in $USER_PROFILES or $SITE_PROFILES"; fi
}
if [ "$LIST_PROFILES" = 1 ]; then
    for dir in "$USER_PROFILES" "$SITE_PROFILES"; do
        [ -d "$dir" ] || continue
        for f in "$dir"/*.conf; do
            [ -f "$f" ] || continue
            d=$(sed -n 's/^[[:space:]]*description[[:space:]]*=[[:space:]]*//p' "$f" | head -1)
            printf '%-20s %-6s %s\n' "$(basename "$f" .conf)" "$([ "$dir" = "$USER_PROFILES" ] && echo user || echo site)" "$d"
        done
    done
    exit 0
fi
CLI_READ=("${READ_REQ[@]}"); CLI_WRITE=("${WRITE_REQ[@]}"); READ_REQ=(); WRITE_REQ=()
[ -f "$USER_CONFIG" ] && apply_conf "$USER_CONFIG" config
[ -n "${LIBD_AI_SANDBOX_HOME_MODE:-}" ] && HOME_MODE=$LIBD_AI_SANDBOX_HOME_MODE
for pr in "${PROFILES[@]}"; do
    f=$(find_profile "$pr"); PROFILE_FILES+=("$f")
    apply_conf "$f" profile
done
[ -n "$CLI_HOME_MODE" ] && HOME_MODE=$CLI_HOME_MODE
[ -n "$CLI_SCRATCH" ] && SCRATCH_RW=$(yesno "$CLI_SCRATCH")
[ -n "$CLI_PERSONAL" ] && PERSONAL_LIBS=$(yesno "$CLI_PERSONAL")
[ -n "$CLI_AGENT" ] && AGENT=$CLI_AGENT
READ_REQ+=("${CLI_READ[@]}"); WRITE_REQ+=("${CLI_WRITE[@]}"); MODULES+=("${CLI_MODULES[@]}")
for m in "${MODULES[@]}"; do
    [[ "$m" =~ ^[A-Za-z0-9_.+/-]+$ ]] || die "invalid module name '$m'"
done

case "$AGENT" in
    shell) ;;
    codex|claude) die "--agent $AGENT is planned but not implemented yet; use --agent shell" ;;
    *) die "unknown agent '$AGENT'" ;;
esac
case "$HOME_MODE" in
    synthetic|real-ro|real-rw) ;;
    *) die "--home-mode must be synthetic, real-ro or real-rw (got '$HOME_MODE')" ;;
esac
[ "$RESET_HOME" = 0 ] || [ "$HOME_MODE" = synthetic ] || die "--reset-home only applies to --home-mode synthetic"

# ------------------------------------------------------------ preconditions --
HOST=$(hostname)
case "${HOST%%.*}" in
    compute-*|transfer-*) ;;
    *) [ -n "${LIBD_AI_SANDBOX_ANY_HOST:-}" ] ||
       die "run this on a compute or transfer node (e.g. 'srun --pty bash'), not on $HOST" ;;
esac
[ -x "$RUNTIME" ] || die "container runtime not found or not executable: $RUNTIME"
[ -f "$MOUNTS" ] || die "mounts file not found: $MOUNTS"
[ -d "$ROOTFS" ] || die "rootfs skeleton not found: $ROOTFS (create it with $ROOT/libexec/make-rootfs)"
[ -x "$DENY_BIN" ] || die "deny helper missing: $DENY_BIN"
[ -n "${MYSCRATCH:-}" ] || die "MYSCRATCH is not set"
MYSCRATCH=$(readlink -f "$MYSCRATCH")
[ -d "$MYSCRATCH" ] && [ -O "$MYSCRATCH" ] || die "MYSCRATCH ($MYSCRATCH) is not a directory you own"
[ -d "$REAL_HOME" ] || die "cannot determine your home directory"
SCR=$MYSCRATCH/ai-sandbox
SBX_WORK=$SCR/work
SBX_CACHE=$SCR/cache

# --------------------------------------------------------- mount table ------
MNT_PATH=(); MNT_TYPE=()
load_mount_table() {   # /proc/mounts escapes spaces etc. as octal
    MNT_PATH=(); MNT_TYPE=()
    local dev mp fs rest
    while read -r dev mp fs rest; do
        mp=${mp//\\040/ }; mp=${mp//\\011/$'\t'}; mp=${mp//\\134/\\}
        MNT_PATH+=("$mp"); MNT_TYPE+=("$fs")
    done < /proc/mounts
}
containing_mount() {   # "mountpoint<TAB>fstype" of the filesystem holding $1
    local p=$1 best="" bt="" i m
    for i in "${!MNT_PATH[@]}"; do
        m=${MNT_PATH[$i]}
        if [ "$m" = / ] || [ "$p" = "$m" ] || [[ "$p" == "$m"/* ]]; then
            if [ ${#m} -ge ${#best} ]; then best=$m; bt=${MNT_TYPE[$i]}; fi
        fi
    done
    printf '%s\t%s\n' "$best" "$bt"
}
mounts_below() {       # "mountpoint<TAB>fstype" for every mount strictly below $1
    local p=$1 i m
    for i in "${!MNT_PATH[@]}"; do
        m=${MNT_PATH[$i]}
        if [ "$p" = / ]; then [ "$m" != / ] && printf '%s\t%s\n' "$m" "${MNT_TYPE[$i]}"
        elif [[ "$m" == "$p"/* ]]; then printf '%s\t%s\n' "$m" "${MNT_TYPE[$i]}"; fi
    done | sort -u
}
is_under() {  # PATH equals PREFIX or lies below it
    [ "$1" = "$2" ] || [ "$2" = / ] || [[ "$1" == "$2"/* ]]
}
# lstat/readlink on an autofs indirect-map entry does not mount it; looking up a
# name *inside* it does. Mount it now so /proc/mounts reflects reality.
trigger_automount() { [ -d "$1" ] && ls -d "$1/." >/dev/null 2>&1; return 0; }
not_autofs() {
    local p=$1 what=$2 cm mp fs
    cm=$(containing_mount "$p"); mp=${cm%%$'\t'*}; fs=${cm#*$'\t'}
    [ "$fs" != autofs ] ||
        die "$what $p is an autofs map ($mp); use a mounted export below it instead (e.g. $mp/lieber)"
}

# ------------------------------------------------------ bind bookkeeping ---
BIND_SRC=(); BIND_DST=(); BIND_MODE=(); BIND_NOTE=()
add_bind() { BIND_SRC+=("$1"); BIND_DST+=("$2"); BIND_MODE+=("$3"); BIND_NOTE+=("${4:-}"); }
RO_SRC=(); RO_DST=()
# Read-only sources: a ro bind is recursive, but nested filesystems keep their own
# flags. Re-bind each nested mount read-only; refuse nested autofs maps (anything
# they automount later would arrive with its own, possibly writable, flags).
plan_ro() {
    local src=$1 dst=$2 note=${3:-} row m fs
    not_autofs "$src" "read-only mount"
    add_bind "$src" "$dst" ro "$note"
    RO_SRC+=("$src"); RO_DST+=("$dst")
    while IFS=$'\t' read -r m fs; do
        [ -n "$m" ] || continue
        [ "$fs" != autofs ] || die "read-only mount $src contains an autofs map at $m; list the exports below it instead"
        add_bind "$m" "$dst${m#"$src"}" ro "nested in $src"
    done < <(mounts_below "$src")
}
# Paths requested on the command line keep the spelling the user gave (symlinks
# included) as the destination; the source is the resolved target.
logical_path() { realpath -s -- "$1"; }

# ------------------------------------------------------ mounts files --------
MOUNT_FILES=("$MOUNTS")
[ -f "$USER_MOUNTS" ] && MOUNT_FILES+=("$USER_MOUNTS")
if [ -n "${LIBD_AI_SANDBOX_MOUNTS_EXTRA:-}" ]; then
    [ -f "$LIBD_AI_SANDBOX_MOUNTS_EXTRA" ] || die "extra mounts file not found: $LIBD_AI_SANDBOX_MOUNTS_EXTRA"
    MOUNT_FILES+=("$LIBD_AI_SANDBOX_MOUNTS_EXTRA")
fi
RO_PLAN=()   # "src<TAB>dest<TAB>note" collected first, validated after automounts
parse_mounts_file() {
    local file=$1 line src dest mode req extra n=0
    while IFS= read -r line || [ -n "$line" ]; do
        n=$((n+1))
        line=${line%%#*}
        read -r src dest mode req extra <<<"$line" || true
        [ -n "${src:-}" ] || continue
        [ -n "${req:-}" ] && [ -z "${extra:-}" ] || die "$file:$n: expected 'src dest mode required'"
        [ "$mode" = ro ] || die "$file:$n: mode must be 'ro' ($src); writable paths come only from --write"
        case "$req" in yes|no) ;; *) die "$file:$n: required must be yes or no" ;; esac
        [[ "$src" == /* && "$dest" == /* ]] || die "$file:$n: paths must be absolute"
        if [ ! -e "$src" ]; then
            [ "$req" = yes ] && die "required mount source missing: $src ($file:$n)"
            warn "skipping missing optional mount $src ($file)"
            continue
        fi
        trigger_automount "$src"
        RO_PLAN+=("$(readlink -f "$src")"$'\t'"$dest"$'\t'"")
    done < "$file"
}
for f in "${MOUNT_FILES[@]}"; do parse_mounts_file "$f"; done

# ------------------------------------------------- command-line paths -------
home_conflict() {   # dest or src equal to / an ancestor of the real home
    is_under "$REAL_HOME" "$1"
}
for p in "${READ_REQ[@]}"; do
    [ -e "$p" ] || die "--read path does not exist: $p"
    trigger_automount "$p"
    s=$(readlink -f "$p"); d=$(logical_path "$p")
    if home_conflict "$d" || home_conflict "$s"; then
        die "--read $p covers your real home; use --home-mode real-ro instead"
    fi
    if [ "$HOME_MODE" = real-ro ] && is_under "$d" "$REAL_HOME"; then
        warn "--read $p is redundant with --home-mode real-ro; skipping"; continue
    fi
    RO_PLAN+=("$s"$'\t'"$d"$'\t'"--read")
done

WRITE_PLAN=()   # "src<TAB>dest<TAB>note"
[ "$SCRATCH_RW" = 1 ] && WRITE_PLAN+=("$MYSCRATCH"$'\t'"$MYSCRATCH"$'\t'"\$MYSCRATCH")
for p in "${WRITE_REQ[@]}"; do
    [ -d "$p" ] || die "--write path must be an existing directory: $p (create it first)"
    trigger_automount "$p"
    s=$(readlink -f "$p"); d=$(logical_path "$p")
    if home_conflict "$d" || home_conflict "$s"; then
        die "refusing --write $p: it is or contains your real home (see --home-mode real-rw)"
    fi
    if [ "$HOME_MODE" = real-rw ] && is_under "$d" "$REAL_HOME"; then
        warn "--write $p is redundant with --home-mode real-rw; skipping"; continue
    fi
    WRITE_PLAN+=("$s"$'\t'"$d"$'\t'"--write")
done

# ------------------------------------------------------------- home mode ----
HOME_ARGS=()
case "$HOME_MODE" in
    synthetic)
        if [ ! -e "$SBX_HOME" ]; then
            if is_under "$SBX_HOME" "$REAL_HOME" || is_under "$SBX_HOME" "$MYSCRATCH"; then :
            else die "synthetic home $SBX_HOME does not exist; create it first"; fi
        fi
        ;;
    real-ro)
        trigger_automount "$REAL_HOME"
        RO_PLAN+=("$(readlink -f "$REAL_HOME")"$'\t'"$REAL_HOME"$'\t'"real home")
        HOME_ARGS=(--no-home)
        ;;
    real-rw)
        HOME_ARGS=(--home "$REAL_HOME")
        ;;
esac

# Personal R and Python libraries of the real home, read-only, for synthetic mode.
PERSONAL_R=""; PERSONAL_PY=""
if [ "$HOME_MODE" = synthetic ] && [ "$PERSONAL_LIBS" = 1 ]; then
    if [ -d "$REAL_HOME/R" ]; then
        PERSONAL_R=$(readlink -f "$REAL_HOME/R")
        RO_PLAN+=("$PERSONAL_R"$'\t'"$HOST_HOME_DIR/R"$'\t'"personal R libs")
        [ -f "$R_HOOK" ] || die "R profile hook missing: $R_HOOK"
        RO_PLAN+=("$R_HOOK"$'\t'"/.libd-ai-sandbox/Rprofile.R"$'\t'"R hook")
    fi
    if [ -d "$REAL_HOME/.local/lib" ]; then
        PERSONAL_PY=$(readlink -f "$REAL_HOME/.local/lib")
        RO_PLAN+=("$PERSONAL_PY"$'\t'"$HOST_HOME_DIR/.local/lib"$'\t'"personal Python libs")
    fi
fi

load_mount_table   # after all automount triggers

for row in "${RO_PLAN[@]}"; do
    IFS=$'\t' read -r s d note <<<"$row"
    plan_ro "$s" "$d" "$note"
done

check_writable() {   # validate a path that will be mounted (or used) read-write
    local s=$1 d=$2 what=$3 pp r cm mp below
    [ "$s" != / ] && [ "$d" != / ] || die "refusing to make / writable"
    for pp in "${PROTECTED_PREFIXES[@]}"; do
        if is_under "$s" "$pp" || is_under "$d" "$pp"; then
            die "refusing to make system/shared path writable: $what $d"
        fi
    done
    # A read-only mount nested inside a writable one is fine (it is mounted after
    # its parent and wins) as long as it lands at the matching place inside; if the
    # writable bind exposes the same data at another path, the ro mount would not
    # cover it there.
    local k r rd
    for k in "${!RO_SRC[@]}"; do
        r=${RO_SRC[$k]}; rd=${RO_DST[$k]}
        [ "$s" != "$r" ] || die "refusing $what $d: it is a whole read-only mount; pick a directory inside it"
        if [[ "$r" == "$s"/* ]] && [ "$rd" != "$d${r#"$s"}" ]; then
            die "refusing $what $d: it contains the read-only mount $r at a different path inside"
        fi
        if [[ "$rd" == "$d"/* ]] && [ "$r" != "$s${rd#"$d"}" ]; then
            die "refusing $what $d: it contains the read-only mount point $rd for different data"
        fi
    done
    cm=$(containing_mount "$s"); mp=${cm%%$'\t'*}
    if [ "$s" = "$mp" ] && [ "$s" != "$MYSCRATCH" ] && [ "$s" != "$REAL_HOME" ]; then
        die "refusing $what $d: it is an entire filesystem; pick a directory inside it"
    fi
    not_autofs "$s" "$what"
    below=$(mounts_below "$s" | cut -f1)
    if [ -n "$below" ]; then
        if [ "$s" = "$REAL_HOME" ]; then
            if mounts_below "$s" | grep -q $'\tautofs$'; then
                die "your home contains an autofs map; cannot mount it"
            fi
        else
            die "$what $d has filesystems mounted below it, which would keep their own flags:"$'\n'"$below"
        fi
    fi
}

for row in "${WRITE_PLAN[@]}"; do
    IFS=$'\t' read -r s d note <<<"$row"
    check_writable "$s" "$d" "${note:---write}"
    add_bind "$s" "$d" rw "$note"
done

case "$HOME_MODE" in
    synthetic)
        # Validate the path the home will have; do not create anything before launch
        # (--dry-run and --print-binds must not touch the filesystem).
        SBX_HOME=$(realpath -m -- "$SBX_HOME")
        home_conflict "$SBX_HOME" && die "synthetic home $SBX_HOME may not be or contain your real home"
        check_writable "$SBX_HOME" "$SBX_HOME" "synthetic home"
        HOME_ARGS=(--home "$SBX_HOME:$REAL_HOME")
        ;;
    real-rw)
        check_writable "$REAL_HOME" "$REAL_HOME" "real home"
        ;;
esac

# Caches go to scratch so they do not fill the home quota. Without the
# $MYSCRATCH bind the cache directory is bound on its own.
[ "$SCRATCH_RW" = 1 ] || add_bind "$SBX_CACHE" "$SBX_CACHE" rw "cache"

# Deny wrappers over escape commands
if [ -f "$DENY_LIST" ]; then
    while IFS= read -r c || [ -n "$c" ]; do
        c=${c%%#*}; c=${c//[[:space:]]/}
        [ -n "$c" ] || continue
        [ -e "$c" ] && add_bind "$DENY_BIN" "$c" ro "deny"
    done < "$DENY_LIST"
fi

# Parents must be mounted before children: order by destination depth, and drop
# exact duplicate destinations (the runtime ignores later ones anyway).
ORDER=$(for i in "${!BIND_DST[@]}"; do
            d=${BIND_DST[$i]}; s=${d//[^\/]/}
            printf '%d\t%s\t%d\n' "${#s}" "$d" "$i"
        done | sort -t$'\t' -k1,1n -k2,2 -k3,3n | awk -F'\t' '!seen[$2]++' | cut -f3)

BIND_ARGS=(); BIND_TABLE=()
for i in $ORDER; do
    s=${BIND_SRC[$i]}; d=${BIND_DST[$i]}; m=${BIND_MODE[$i]}
    if [ "$m" = ro ]; then BIND_ARGS+=(--bind "$s:$d:ro"); else BIND_ARGS+=(--bind "$s:$d"); fi
    BIND_TABLE+=("$m"$'\t'"$s"$'\t'"$d"$'\t'"${BIND_NOTE[$i]}")
done

WRITABLE=()
for row in "${WRITE_PLAN[@]}"; do IFS=$'\t' read -r s d note <<<"$row"; WRITABLE+=("$d"); done
case "$HOME_MODE" in
    synthetic) WRITABLE+=("$REAL_HOME (synthetic: $SBX_HOME)") ;;
    real-rw)   WRITABLE+=("$REAL_HOME (REAL home)") ;;
esac
RW_LIST=$(printf '%s:' "${WRITABLE[@]%% (*}" /tmp); RW_LIST=${RW_LIST%:}

# ------------------------------------------------------------ in-container --
HOST_PWD=$(pwd -P 2>/dev/null || echo /)
INNER_PWD=$REAL_HOME
if [ "$HOME_MODE" != synthetic ] && is_under "$HOST_PWD" "$REAL_HOME"; then INNER_PWD=$HOST_PWD; fi
for i in "${!BIND_DST[@]}"; do
    s=${BIND_SRC[$i]}
    if [ -d "$s" ] && [ "${BIND_NOTE[$i]}" != deny ] && is_under "$HOST_PWD" "$s"; then
        INNER_PWD=${BIND_DST[$i]}${HOST_PWD#"$s"}; break
    fi
done

# Modules are loaded after the login profile and before the command. For an
# interactive session the login shell then execs an interactive shell, which
# inherits the loaded modules.
PRELUDE=""
if [ ${#MODULES[@]} -gt 0 ]; then
    PRELUDE="module load ${MODULES[*]} || echo '$PROG: some modules failed to load' >&2"
fi
if [ -z "$PRELUDE" ]; then
    if [ -n "$CMD_STR" ]; then INNER=(bash -lc "$CMD_STR")
    elif [ ${#ARGV[@]} -gt 0 ]; then INNER=(bash -lc 'exec "$@"' "$PROG" "${ARGV[@]}")
    else INNER=(bash -l); fi
else
    if [ -n "$CMD_STR" ]; then INNER=(bash -lc "$PRELUDE"$'\n'"$CMD_STR")
    elif [ ${#ARGV[@]} -gt 0 ]; then INNER=(bash -lc "$PRELUDE"$'\n''exec "$@"' "$PROG" "${ARGV[@]}")
    else INNER=(bash -lc "$PRELUDE"$'\n''exec bash -i'); fi
fi
EXTRA_ENV=()
[ -n "$PERSONAL_R" ] && EXTRA_ENV+=(--env "R_PROFILE_USER=/.libd-ai-sandbox/Rprofile.R")

CMD=("$RUNTIME" exec
     --contain --cleanenv --no-mount cwd
     "${HOME_ARGS[@]}"
     --workdir "$SBX_WORK"
     --pwd "$INNER_PWD"
     --env "TERM=${TERM:-xterm}"
     --env "XDG_CACHE_HOME=$SBX_CACHE"
     --env "LIBD_AI_SANDBOX=$VERSION"
     --env "LIBD_AI_SANDBOX_HOME_MODE=$HOME_MODE"
     --env "LIBD_AI_SANDBOX_RW=$RW_LIST"
     "${EXTRA_ENV[@]}"
     "${BIND_ARGS[@]}"
     "$ROOTFS"
     "${INNER[@]}")

print_binds() {
    printf '%-4s %-48s %s\n' MODE SOURCE DEST
    local row m s d n
    for row in "${BIND_TABLE[@]}"; do
        IFS=$'\t' read -r m s d n <<<"$row"
        [ "$n" = deny ] && s="(deny)"
        [ -n "$n" ] && [ "$n" != deny ] && d="$d   [$n]"
        printf '%-4s %-48s %s\n' "$m" "$s" "$d"
    done
    case "$HOME_MODE" in
        synthetic) printf '%-4s %-48s %s\n' rw "$SBX_HOME" "$REAL_HOME   [synthetic home]" ;;
        real-ro)   ;;
        real-rw)   printf '%-4s %-48s %s\n' rw "$REAL_HOME" "$REAL_HOME   [REAL home, writable]" ;;
    esac
    printf '%-4s %-48s %s\n' rw "$SBX_WORK/{tmp,var_tmp}" "/tmp, /var/tmp"
}

if [ "$PRINT_BINDS" = 1 ]; then print_binds; exit 0; fi

# ------------------------------------------------------------------ logging --
json_str() {
    local s=$1
    s=${s//\\/\\\\}; s=${s//\"/\\\"}; s=${s//$'\n'/\\n}; s=${s//$'\t'/\\t}; s=${s//$'\r'/\\r}
    printf '"%s"' "$s"
}
json_arr() { local sep="" x; printf '['; for x in "$@"; do printf '%s' "$sep"; json_str "$x"; sep=,; done; printf ']'; }
write_log() {
    local f=$1 sep="" row m s d n
    {
        printf '{\n'
        printf '  "time": %s,\n' "$(json_str "$(date -Iseconds)")"
        printf '  "user": %s,\n' "$(json_str "$(id -un)")"
        printf '  "host": %s,\n' "$(json_str "$HOST")"
        printf '  "slurm_job_id": %s,\n' "$(json_str "${SLURM_JOB_ID:-}")"
        printf '  "wrapper": %s,\n' "$(json_str "$SELF $VERSION")"
        printf '  "runtime": %s,\n' "$(json_str "$RUNTIME")"
        printf '  "runtime_version": %s,\n' "$(json_str "$("$RUNTIME" --version 2>&1 | head -1)")"
        printf '  "host_os": %s,\n' "$(json_str "$(cat /etc/redhat-release 2>/dev/null)")"
        printf '  "rootfs": %s,\n' "$(json_str "$ROOTFS")"
        printf '  "mounts_files": %s,\n' "$(json_arr "${MOUNT_FILES[@]}")"
        printf '  "agent": %s,\n' "$(json_str "$AGENT")"
        printf '  "home_mode": %s,\n' "$(json_str "$HOME_MODE")"
        printf '  "profiles": %s,\n' "$(json_arr "${PROFILE_FILES[@]}")"
        printf '  "modules": %s,\n' "$(json_arr "${MODULES[@]}")"
        printf '  "personal_libs": %s,\n' "$([ -n "$PERSONAL_R$PERSONAL_PY" ] && echo true || echo false)"
        printf '  "writable": %s,\n' "$(json_arr "${WRITABLE[@]}" "$SBX_WORK")"
        printf '  "host_cwd": %s,\n' "$(json_str "$HOST_PWD")"
        printf '  "binds": ['
        for row in "${BIND_TABLE[@]}"; do
            IFS=$'\t' read -r m s d n <<<"$row"
            printf '%s\n    {"mode": %s, "src": %s, "dest": %s, "note": %s}' "$sep" \
                "$(json_str "$m")" "$(json_str "$s")" "$(json_str "$d")" "$(json_str "$n")"
            sep=,
        done
        printf '\n  ],\n'
        printf '  "command": %s\n' "$(json_arr "${CMD[@]}")"
        printf '}\n'
    } > "$f"
}

if [ "$DRY_RUN" = 1 ]; then
    print_binds
    echo
    printf '%q ' "${CMD[@]}"; echo
    exit 0
fi

# ------------------------------------------------------------ prepare dirs --
init_synthetic_home() {
    if [ "$RESET_HOME" = 1 ] && [ -d "$SBX_HOME" ]; then
        local archived
        archived=$SBX_HOME.$(date +%Y%m%d-%H%M%S)
        mv "$SBX_HOME" "$archived"
        echo "$PROG: previous synthetic home archived to $archived" >&2
    fi
    if [ ! -d "$SBX_HOME" ] && [ -d "$SCR/home" ] && [ "$SBX_HOME" != "$SCR/home" ]; then
        warn "an older synthetic home exists at $SCR/home; to keep it: mv $SCR/home $SBX_HOME"
    fi
    mkdir -p "$SBX_HOME"
    chmod 700 "$SBX_HOME"
    # Durable per-user template first, so it wins over the built-in defaults.
    [ -d "$SKEL" ] && cp -a --no-clobber "$SKEL/." "$SBX_HOME/"
    mkdir -p "$SBX_HOME"/{.config,.local/bin,R}
    # Python: a .pth file in each per-version user site of the synthetic home
    # appends the real home's matching user site (read-only) to sys.path.
    if [ -n "$PERSONAL_PY" ]; then
        local sp v
        for sp in "$PERSONAL_PY"/python*/site-packages; do
            [ -d "$sp" ] || continue
            v=$(basename "$(dirname "$sp")")
            mkdir -p "$SBX_HOME/.local/lib/$v/site-packages"
            echo "$HOST_HOME_DIR/.local/lib/$v/site-packages" > "$SBX_HOME/.local/lib/$v/site-packages/libd-ai-sandbox-host.pth"
        done
    fi
    if [ ! -e "$SBX_HOME/.bashrc" ]; then
        {
            echo "# ~/.bashrc of the libd-ai-sandbox synthetic home (not your real home)."
            echo "# Host path: $SBX_HOME/.bashrc"
            cat <<'EOF'
# Edit it from the host or inside the sandbox (nano ~/.bashrc); in a running
# session apply changes with 'source ~/.bashrc'. The wrapper never overwrites this
# file. For a template that survives --reset-home, keep a copy in
# ~/.config/libd-ai-sandbox/skel/.bashrc (on the host).
# Runs at the start of every session, after the JHPCE site profile, so it is the
# place for 'module load ...' lines. Do not 'set -u' before module commands.
[ -f /etc/bashrc ] && . /etc/bashrc
PS1='[sbx \u@\h \W]\$ '
export EDITOR=nano
# module load conda_R/4.5.x
EOF
        } > "$SBX_HOME/.bashrc"
    fi
    if [ ! -e "$SBX_HOME/.bash_profile" ]; then
        printf '%s\n' '# Generated by libd-ai-sandbox' '[ -f ~/.bashrc ] && . ~/.bashrc' > "$SBX_HOME/.bash_profile"
    fi
}

mkdir -p "$SCR" "$SBX_WORK" "$SBX_CACHE" "$SBX_LOGS"
chmod 700 "$SCR" "$STATE" 2>/dev/null || true
if [ "$HOME_MODE" = synthetic ]; then init_synthetic_home; fi
LOG=$SBX_LOGS/$(date +%Y%m%d-%H%M%S)-$$.json
write_log "$LOG"

if [ "$QUIET" != 1 ]; then
    {
        echo "$PROG $VERSION: LIBD/JHPCE storage is read-only in this session."
        printf '  writable: %s\n' "${WRITABLE[@]}" /tmp
        [ "$HOME_MODE" = real-rw ] &&
            echo "  WARNING: your real home is writable; the agent can change dotfiles that your host logins run."
        echo "  log:      $LOG"
    } >&2
fi
exec "${CMD[@]}"
