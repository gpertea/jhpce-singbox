#!/usr/bin/env bash
# libd-ai-sandbox: run a shell or an AI agent on JHPCE with LIBD/JHPCE storage
# mounted read-only. Only $MYSCRATCH and paths given with --write are writable.
#
# The container root is a skeleton directory; the host's /usr, /etc, /opt and the
# storage/software trees from etc/mounts.tsv are bind-mounted read-only on top, so
# the environment (modules, conda_R, Slurm config, users) matches the host node.
set -euo pipefail

PROG=libd-ai-sandbox
VERSION=0.1.0-dev
SELF=$(readlink -f "${BASH_SOURCE[0]}")
ROOT=${LIBD_AI_SANDBOX_ROOT:-$(dirname "$(dirname "$SELF")")}
RUNTIME=${LIBD_AI_SANDBOX_RUNTIME:-/jhpce/shared/jhpce/core/singularity/3.11.4/bin/singularity}
MOUNTS=${LIBD_AI_SANDBOX_MOUNTS:-$ROOT/etc/mounts.tsv}
MOUNTS_EXTRA=${LIBD_AI_SANDBOX_MOUNTS_EXTRA:-}
ROOTFS=${LIBD_AI_SANDBOX_ROOTFS:-$ROOT/share/rootfs}
DENY_LIST=${LIBD_AI_SANDBOX_DENY:-$ROOT/etc/deny-commands.txt}
DENY_BIN=$ROOT/libexec/deny

# Host paths that may never be made writable.
PROTECTED_PREFIXES=(/usr /etc /opt /var /boot /proc /sys /dev /run /jhpce/shared)

usage() {
    cat <<EOF
Usage: $PROG [options] [-- command [args...]]

Starts a login shell (or the given command) in a container where LIBD/JHPCE storage
is read-only. Writable: \$MYSCRATCH (unless --no-scratch), and each --write PATH.

Options:
  --write PATH      make PATH writable at the same absolute path (repeatable).
                    PATH must already exist, may not be a whole filesystem
                    (e.g. /dcs04/lieber), and may not contain mounted filesystems
  --read PATH       add PATH read-only at the same path (repeatable), for data
                    outside the default mounts; same mount rules as mounts.tsv
  --no-scratch      do not mount \$MYSCRATCH writable (synthetic home and /tmp
                    in \$MYSCRATCH/ai-sandbox stay writable)
  --cmd STRING      run STRING with 'bash -lc' instead of an interactive shell
  --agent NAME      shell (default); codex and claude are not implemented yet
  --reset-home      archive the synthetic home and start a fresh one
  --dry-run         print binds and the runtime command, then exit
  --print-binds     print the resolved bind table and exit
  --quiet           suppress the startup banner and warnings
  --version
  -h, --help

Environment:
  LIBD_AI_SANDBOX_RUNTIME       runtime binary [$RUNTIME]
  LIBD_AI_SANDBOX_MOUNTS        read-only mounts file [$MOUNTS]
  LIBD_AI_SANDBOX_MOUNTS_EXTRA  optional second mounts file (same format)
  LIBD_AI_SANDBOX_ROOTFS        skeleton root directory [$ROOTFS]
EOF
}

die()  { echo "$PROG: error: $*" >&2; exit 2; }
warn() { [ "$QUIET" = 1 ] || echo "$PROG: warning: $*" >&2; }

# ---------------------------------------------------------------- options --
WRITE_REQ=(); READ_REQ=(); CMD_STR=""; AGENT=shell; SCRATCH_RW=1
DRY_RUN=0; PRINT_BINDS=0; QUIET=0; RESET_HOME=0; ARGV=()
while [ $# -gt 0 ]; do
    case "$1" in
        --write)        [ $# -ge 2 ] || die "--write needs a path"; WRITE_REQ+=("$2"); shift 2 ;;
        --write=*)      WRITE_REQ+=("${1#*=}"); shift ;;
        --read)         [ $# -ge 2 ] || die "--read needs a path"; READ_REQ+=("$2"); shift 2 ;;
        --read=*)       READ_REQ+=("${1#*=}"); shift ;;
        --no-scratch)   SCRATCH_RW=0; shift ;;
        --cmd)          [ $# -ge 2 ] || die "--cmd needs a string"; CMD_STR=$2; shift 2 ;;
        --agent)        [ $# -ge 2 ] || die "--agent needs a name"; AGENT=$2; shift 2 ;;
        --agent=*)      AGENT=${1#*=}; shift ;;
        --reset-home)   RESET_HOME=1; shift ;;
        --dry-run)      DRY_RUN=1; shift ;;
        --print-binds)  PRINT_BINDS=1; shift ;;
        --quiet|-q)     QUIET=1; shift ;;
        --version)      echo "$PROG $VERSION"; exit 0 ;;
        -h|--help)      usage; exit 0 ;;
        --)             shift; ARGV=("$@"); break ;;
        *)              die "unknown option '$1' (see --help)" ;;
    esac
done
[ -z "$CMD_STR" ] || [ ${#ARGV[@]} -eq 0 ] || die "use either --cmd or '-- command', not both"
case "$AGENT" in
    shell) ;;
    codex|claude) die "--agent $AGENT is planned but not implemented yet; use --agent shell" ;;
    *) die "unknown agent '$AGENT'" ;;
esac

# ------------------------------------------------------------ preconditions --
HOST=$(hostname)
case "${HOST%%.*}" in
    compute-*|transfer-*) ;;
    *) [ -n "${LIBD_AI_SANDBOX_ANY_HOST:-}" ] ||
       die "run this on a compute or transfer node (e.g. 'srun --pty bash'), not on $HOST" ;;
esac
[ -x "$RUNTIME" ] || die "container runtime not found or not executable: $RUNTIME"
[ -f "$MOUNTS" ] || die "mounts file not found: $MOUNTS"
[ -d "$ROOTFS" ] || die "rootfs skeleton not found: $ROOTFS (create it with $ROOT/libexec/make-rootfs)"
[ -x "$DENY_BIN" ] || die "deny helper missing: $DENY_BIN"
[ -n "${MYSCRATCH:-}" ] || die "MYSCRATCH is not set"
MYSCRATCH=$(readlink -f "$MYSCRATCH")
[ -d "$MYSCRATCH" ] && [ -O "$MYSCRATCH" ] || die "MYSCRATCH ($MYSCRATCH) is not a directory you own"
REAL_HOME=$HOME

# --------------------------------------------------------- mount table ------
# /proc/mounts escapes spaces etc. as octal; decode the ones that occur in paths.
MNT_PATH=(); MNT_TYPE=()
load_mount_table() {
    MNT_PATH=(); MNT_TYPE=()
    local dev mp fs rest
    while read -r dev mp fs rest; do
        mp=${mp//\\040/ }; mp=${mp//\\011/$'\t'}; mp=${mp//\\134/\\}
        MNT_PATH+=("$mp"); MNT_TYPE+=("$fs")
    done < /proc/mounts
}
# Print "mountpoint<TAB>fstype" of the filesystem containing $1 (longest prefix).
containing_mount() {
    local p=$1 best="" bt="" i m
    for i in "${!MNT_PATH[@]}"; do
        m=${MNT_PATH[$i]}
        if [ "$m" = / ] || [ "$p" = "$m" ] || [[ "$p" == "$m"/* ]]; then
            if [ ${#m} -ge ${#best} ]; then best=$m; bt=${MNT_TYPE[$i]}; fi
        fi
    done
    printf '%s\t%s\n' "$best" "$bt"
}
# Print every mount point strictly below $1.
mounts_below() {
    local p=$1 m
    for m in "${MNT_PATH[@]}"; do
        if [ "$p" = / ]; then [ "$m" != / ] && echo "$m"
        elif [[ "$m" == "$p"/* ]]; then echo "$m"; fi
    done | sort -u
}
is_under() {  # is_under PATH PREFIX : PATH equals PREFIX or lies below it
    [ "$1" = "$2" ] || [ "$2" = / ] || [[ "$1" == "$2"/* ]]
}
# A path is safe to bind as one unit if it is not an autofs map and nothing is
# mounted below it (nested mounts would keep their own, possibly rw, flags).
check_single_fs() {
    local p=$1 what=$2 cm mp fs below
    cm=$(containing_mount "$p"); mp=${cm%%$'\t'*}; fs=${cm#*$'\t'}
    [ "$fs" != autofs ] ||
        die "$what $p is an autofs map ($mp); bind a mounted export below it instead (e.g. $mp/lieber)"
    below=$(mounts_below "$p")
    [ -z "$below" ] ||
        die "$what $p has filesystems mounted below it, which a bind would not cover:"$'\n'"$below"
}

# ------------------------------------------------------ resolve bind list ---
# lstat/readlink on an autofs indirect-map entry does not mount it; looking up a
# name *inside* it does. Mount it now so /proc/mounts reflects reality.
trigger_automount() { [ -d "$1" ] && ls -d "$1/." >/dev/null 2>&1; return 0; }
BIND_SRC=(); BIND_DST=(); BIND_MODE=()
add_bind() { BIND_SRC+=("$1"); BIND_DST+=("$2"); BIND_MODE+=("$3"); }

# 1. read-only mounts from the config file(s)
RO_SRC=()
parse_mounts_file() {
    local file=$1 line src dest mode req extra n=0
    while IFS= read -r line || [ -n "$line" ]; do
        n=$((n+1))
        line=${line%%#*}
        read -r src dest mode req extra <<<"$line" || true
        [ -n "${src:-}" ] || continue
        [ -n "${req:-}" ] && [ -z "${extra:-}" ] || die "$file:$n: expected 'src dest mode required'"
        [ "$mode" = ro ] || die "$file:$n: mode must be 'ro' ($src); writable paths come only from --write"
        case "$req" in yes|no) ;; *) die "$file:$n: required must be yes or no" ;; esac
        [[ "$src" == /* && "$dest" == /* ]] || die "$file:$n: paths must be absolute"
        if [ ! -e "$src" ]; then
            [ "$req" = yes ] && die "required mount source missing: $src ($file:$n)"
            warn "skipping missing optional mount $src"
            continue
        fi
        trigger_automount "$src"
        src=$(readlink -f "$src")
        RO_SRC+=("$src"); add_bind "$src" "$dest" ro
    done < "$file"
}
parse_mounts_file "$MOUNTS"
[ -z "$MOUNTS_EXTRA" ] || { [ -f "$MOUNTS_EXTRA" ] || die "extra mounts file not found: $MOUNTS_EXTRA"; parse_mounts_file "$MOUNTS_EXTRA"; }

# 2. --read paths (same path inside)
for p in "${READ_REQ[@]}"; do
    [ -e "$p" ] || die "--read path does not exist: $p"
    trigger_automount "$p"
    p=$(readlink -f "$p")
    RO_SRC+=("$p"); add_bind "$p" "$p" ro
done

# 3. writable paths: $MYSCRATCH and --write
WRITE_PATHS=()
[ "$SCRATCH_RW" = 1 ] && WRITE_PATHS+=("$MYSCRATCH")
for p in "${WRITE_REQ[@]}"; do
    [ -d "$p" ] || die "--write path must be an existing directory: $p (create it first)"
    trigger_automount "$p"
    WRITE_PATHS+=("$(readlink -f "$p")")
done

load_mount_table   # after readlink -f above, so automounts have been triggered

for i in "${!BIND_SRC[@]}"; do
    check_single_fs "${BIND_SRC[$i]}" "read-only mount"
done

for w in "${WRITE_PATHS[@]}"; do
    [ "$w" != / ] || die "refusing to make / writable"
    for pp in "${PROTECTED_PREFIXES[@]}"; do
        is_under "$w" "$pp" && die "refusing to make system/shared path writable: $w"
    done
    if is_under "$w" "$REAL_HOME" || is_under "$REAL_HOME" "$w"; then
        die "refusing --write $w: it overlaps your real home, which the synthetic home replaces"
    fi
    for r in "${RO_SRC[@]}"; do
        [ "$w" != "$r" ] || die "refusing --write $w: it is a whole read-only mount; pick a directory inside it"
        if [[ "$r" == "$w"/* ]]; then die "refusing --write $w: it contains the read-only mount $r"; fi
    done
    cm=$(containing_mount "$w"); mp=${cm%%$'\t'*}
    if [ "$w" = "$mp" ] && [ "$w" != "$MYSCRATCH" ]; then
        die "refusing --write $w: it is an entire filesystem; pick a directory inside it"
    fi
    check_single_fs "$w" "writable path"
    add_bind "$w" "$w" rw
done

# 4. deny wrappers over escape commands
if [ -f "$DENY_LIST" ]; then
    while IFS= read -r c || [ -n "$c" ]; do
        c=${c%%#*}; c=${c//[[:space:]]/}
        [ -n "$c" ] || continue
        [ -e "$c" ] && add_bind "$DENY_BIN" "$c" ro
    done < "$DENY_LIST"
fi

# Parents must be mounted before children: order binds by destination depth.
ORDER=$(for i in "${!BIND_DST[@]}"; do
            d=${BIND_DST[$i]}; s=${d//[^\/]/}
            printf '%d\t%s\t%d\n' "${#s}" "$d" "$i"
        done | sort -t$'\t' -k1,1n -k2,2 | cut -f3)

BIND_ARGS=(); BIND_TABLE=()
for i in $ORDER; do
    s=${BIND_SRC[$i]}; d=${BIND_DST[$i]}; m=${BIND_MODE[$i]}
    [ "$m" = ro ] && BIND_ARGS+=(--bind "$s:$d:ro") || BIND_ARGS+=(--bind "$s:$d")
    BIND_TABLE+=("$m"$'\t'"$s"$'\t'"$d")
done

# ------------------------------------------------------------ scratch dirs --
SBX=$MYSCRATCH/ai-sandbox
SBX_HOME=$SBX/home
SBX_WORK=$SBX/work
SBX_LOGS=$SBX/logs

init_home() {
    mkdir -p "$SBX_HOME"/{.cache,.config,.local/bin,R}
    if [ ! -e "$SBX_HOME/.bashrc" ]; then
        cat > "$SBX_HOME/.bashrc" <<'EOF'
# Generated by libd-ai-sandbox. This is the synthetic home in $MYSCRATCH/ai-sandbox/home,
# not your real home; edit freely.
[ -f /etc/bashrc ] && . /etc/bashrc
PS1='[sbx \u@\h \W]\$ '
EOF
    fi
    if [ ! -e "$SBX_HOME/.bash_profile" ]; then
        printf '%s\n' '# Generated by libd-ai-sandbox' '[ -f ~/.bashrc ] && . ~/.bashrc' > "$SBX_HOME/.bash_profile"
    fi
}

# ------------------------------------------------------------ in-container --
INNER_PWD=$REAL_HOME
HOST_PWD=$(pwd -P 2>/dev/null || echo /)
for i in "${!BIND_DST[@]}"; do
    if [ "${BIND_SRC[$i]}" = "${BIND_DST[$i]}" ] && [ -d "${BIND_SRC[$i]}" ] && is_under "$HOST_PWD" "${BIND_SRC[$i]}"; then
        INNER_PWD=$HOST_PWD; break
    fi
done

if [ -n "$CMD_STR" ]; then
    INNER=(bash -lc "$CMD_STR")
elif [ ${#ARGV[@]} -gt 0 ]; then
    INNER=(bash -lc 'exec "$@"' "$PROG" "${ARGV[@]}")
else
    INNER=(bash -l)
fi

RW_LIST=$(printf '%s:' "${WRITE_PATHS[@]}"); RW_LIST=${RW_LIST%:}
CMD=("$RUNTIME" exec
     --contain --cleanenv --no-mount cwd
     --home "$SBX_HOME:$REAL_HOME"
     --workdir "$SBX_WORK"
     --pwd "$INNER_PWD"
     --env "TERM=${TERM:-xterm}"
     --env "LIBD_AI_SANDBOX=$VERSION"
     --env "LIBD_AI_SANDBOX_RW=$RW_LIST"
     "${BIND_ARGS[@]}"
     "$ROOTFS"
     "${INNER[@]}")

print_binds() {
    printf '%-4s %-45s %s\n' MODE SOURCE DEST
    local row
    for row in "${BIND_TABLE[@]}"; do
        IFS=$'\t' read -r m s d <<<"$row"
        [ "$s" = "$DENY_BIN" ] && s="(deny)"
        printf '%-4s %-45s %s\n' "$m" "$s" "$d"
    done
    printf '%-4s %-45s %s\n' rw "$SBX_HOME" "$REAL_HOME (synthetic home)"
    printf '%-4s %-45s %s\n' rw "$SBX_WORK/{tmp,var_tmp}" "/tmp, /var/tmp"
}

if [ "$PRINT_BINDS" = 1 ]; then print_binds; exit 0; fi

# ------------------------------------------------------------------ logging --
json_str() {
    local s=$1
    s=${s//\\/\\\\}; s=${s//\"/\\\"}; s=${s//$'\n'/\\n}; s=${s//$'\t'/\\t}; s=${s//$'\r'/\\r}
    printf '"%s"' "$s"
}
json_arr() { local sep="" x; printf '['; for x in "$@"; do printf '%s' "$sep"; json_str "$x"; sep=,; done; printf ']'; }
write_log() {
    local f=$1 sep="" row m s d
    {
        printf '{\n'
        printf '  "time": %s,\n' "$(json_str "$(date -Iseconds)")"
        printf '  "user": %s,\n' "$(json_str "$(id -un)")"
        printf '  "host": %s,\n' "$(json_str "$HOST")"
        printf '  "slurm_job_id": %s,\n' "$(json_str "${SLURM_JOB_ID:-}")"
        printf '  "wrapper": %s,\n' "$(json_str "$SELF $VERSION")"
        printf '  "runtime": %s,\n' "$(json_str "$RUNTIME")"
        printf '  "runtime_version": %s,\n' "$(json_str "$("$RUNTIME" --version 2>&1 | head -1)")"
        printf '  "host_os": %s,\n' "$(json_str "$(cat /etc/redhat-release 2>/dev/null)")"
        printf '  "rootfs": %s,\n' "$(json_str "$ROOTFS")"
        printf '  "mounts_files": %s,\n' "$(json_arr "$MOUNTS" ${MOUNTS_EXTRA:+"$MOUNTS_EXTRA"})"
        printf '  "agent": %s,\n' "$(json_str "$AGENT")"
        printf '  "writable": %s,\n' "$(json_arr "${WRITE_PATHS[@]}" "$SBX_HOME" "$SBX_WORK")"
        printf '  "host_cwd": %s,\n' "$(json_str "$HOST_PWD")"
        printf '  "dry_run": %s,\n' "$([ "$DRY_RUN" = 1 ] && echo true || echo false)"
        printf '  "binds": ['
        for row in "${BIND_TABLE[@]}"; do
            IFS=$'\t' read -r m s d <<<"$row"
            printf '%s\n    {"mode": %s, "src": %s, "dest": %s}' "$sep" "$(json_str "$m")" "$(json_str "$s")" "$(json_str "$d")"
            sep=,
        done
        printf '\n  ],\n'
        printf '  "command": %s\n' "$(json_arr "${CMD[@]}")"
        printf '}\n'
    } > "$f"
}

if [ "$DRY_RUN" = 1 ]; then
    print_binds
    echo
    printf '%q ' "${CMD[@]}"; echo
    exit 0
fi

# ------------------------------------------------------------------ launch --
mkdir -p "$SBX" && chmod 700 "$SBX"
if [ "$RESET_HOME" = 1 ] && [ -d "$SBX_HOME" ]; then
    archived=$SBX/home.$(date +%Y%m%d-%H%M%S)
    mv "$SBX_HOME" "$archived"
    echo "$PROG: previous synthetic home archived to $archived" >&2
fi
mkdir -p "$SBX_WORK" "$SBX_LOGS"
init_home
LOG=$SBX_LOGS/$(date +%Y%m%d-%H%M%S)-$$.json
write_log "$LOG"

if [ "$QUIET" != 1 ]; then
    {
        echo "$PROG $VERSION: LIBD/JHPCE storage is read-only in this session."
        echo "  writable: ${WRITE_PATHS[*]:-(none)} + synthetic home, /tmp"
        echo "  log:      $LOG"
    } >&2
fi
exec "${CMD[@]}"
